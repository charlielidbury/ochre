          simpa [Ctx.depth, Nat.succ_eq_add_one, Nat.add_assoc] using hu)
    simpa [Ctx.depth, Nat.succ_eq_add_one, Nat.add_assoc] using hInst
  exact MEqRed.refl
    (BetaInstantiationPreservesPrevalidExtUnderThreeHeads hArgBound hpv) hu'

