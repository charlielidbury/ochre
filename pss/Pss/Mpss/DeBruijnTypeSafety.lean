      {kind₁ kind₂ kind₃ kind₄ kind₅ : CtxEntryKind} {s : Stack},
    WSubMStar Γ arg bound →
      MEqRed ({ bound := head₁, kind := kind₁ } ::
          { bound := head₂, kind := kind₂ } ::
          { bound := head₃, kind := kind₃ } ::
          { bound := head₄, kind := kind₄ } ::
          { bound := head₅, kind := kind₅ } ::
          { bound := bound, kind := .sub } :: Γ) [] t t' →
        Term.Scoped
