                                  { bound := Term.instantiate 1 (Term.shift 0 arg) head₄,
                                    kind := kind₄ } ::
                                  { bound := Term.instantiate 0 arg head₅,
                                    kind := kind₅ } :: Γ)
                                (Stack.instantiate 5
