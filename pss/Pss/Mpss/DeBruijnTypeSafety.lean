        (Term.shift 0 (Term.shift 0 (Term.shift 0 arg))) s)
      (Term.instantiate 3
        (Term.shift 0 (Term.shift 0 (Term.shift 0 arg))) u)
      (Term.instantiate 3
        (Term.shift 0 (Term.shift 0 (Term.shift 0 arg))) u) := by
