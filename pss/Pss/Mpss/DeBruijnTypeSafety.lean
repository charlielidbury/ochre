                            (Term.shift 0
                              (Term.shift 0
                                (Term.shift 0 (Term.instantiate 0 arg head₄)))) :=
                        Ctx.equBinds_weaken_head
                          ({ bound := Term.instantiate 2
                                (Term.shift 0 (Term.shift 0 arg)) head₂,
                              kind := kind₂ } : CtxEntry) htail₁
                      have hbind :
