                    Ctx.equBinds_weaken_head
                      ({ bound := Term.instantiate 3
                            (Term.shift 0 (Term.shift 0 (Term.shift 0 arg))) head₁,
                          kind := kind₁ } : CtxEntry) htail₁
                  have htargetInst :
                      Term.instantiate 4
                          (Term.shift 0 (Term.shift 0 (Term.shift 0 (Term.shift 0 arg))))
