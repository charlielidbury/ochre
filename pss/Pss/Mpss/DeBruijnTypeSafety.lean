    (head₄ := head₃) (kind₄ := kind₃)
    (head₅ := head₄) (kind₅ := kind₄) (s := Stack.shift 0 s)
    hArgBound hBody
  have hBody' :
      MEqRed
        ({ bound := Term.instantiate 4
              (Term.shift 0 (Term.shift 0 (Term.shift 0 (Term.shift 0 arg)))) t,
            kind := CtxEntryKind.sub } ::
          { bound := Term.instantiate 3
