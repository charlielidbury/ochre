              { bound := head₄, kind := kind₄ } ::
              { bound := head₅, kind := kind₅ } ::
              { bound := bound, kind := .sub } :: Γ) (Stack.shift 0 s)
            body body' →
            MEqRed
              ({ bound := Term.instantiate 4
                    (Term.shift 0 (Term.shift 0 (Term.shift 0 (Term.shift 0 arg)))) head₁,
                  kind := kind₁ } ::
                { bound := Term.instantiate 3
