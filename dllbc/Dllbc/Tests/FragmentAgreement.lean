/-- (1) NO OVER-FIRE: structural "program" implies the reflector refuses. -/
def overFire : List String :=
  (corpus.filter (fun c => Term.needsRuntime c.2 && (refusal c.2).isNone)).map (·.1)

/-- (2) Every disagreement is a STATE refusal, never a missed grammar one. -/
def badUnderFire : List String :=
  (corpus.filter (fun c =>
    !Term.needsRuntime c.2 &&
      (match refusal c.2 with | some m => !isStateRefusal m | none => false))).map (·.1)

example : overFire = [] := by native_decide
example : badUnderFire = [] := by native_decide

end Dllbc.Tests.FragmentAgreement

