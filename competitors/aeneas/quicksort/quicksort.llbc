);\n    i\n}","attr_info":{"attributes":[{"DocComment":" Lomuto partition over `s`, using the last element as the pivot."},{"DocComment":""},{"DocComment":" Returns the final pivot index `p`. After the call every element in"},{"DocComment":" `s[0..p]` is `<= s[p]` and every element in `s[p+1..]` is `>= s[p]`."},{"DocComment":""},{"DocComment":" This works purely by swapping inside the single mutable slice `s`; it does"},{"DocComment":" not itself perform the disjoint split. The disjoint `split_at_mut` happens"},{"DocComment":" in `quicksort` once we know the pivot index."}],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"HashConsedValue":[4503,{"Ref":[{"Var":{"Free":0}},{"HashConsedValue":[246,{"Slice":{"HashConsedValue":[245,{"Literal":{"UInt":"U32"}}]}}]},"Mut"]}]}],"output":{"Deduplicated":248}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":0,"beg":{"line":22,"col":0},"end":{"line":36,"col":1}},"generated_from_span":null},"bound_body_regions":17,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":0,"beg":{"line":22,"col":31},"end":{"line":22,"col":36}},"generated_from_span":null},"ty":{"Deduplicated":248}},{"index":1,"name":"s","span":{"data":{"file_id":0,"beg":{"line":22,"col":13},"end":{"line":22,"col":14}},"generated_from_span":null},"ty":{"HashConsedValue":[251,{"Ref":[{"Body":1},{"Deduplicated":246},"Mut"]}]}},{"index":2,"name":"len","span":{"data":{"file_id":0,"beg":{"line":23,"col":8},"end":{"line":23,"col":11}},"generated_from_span":null},"ty":{"Deduplicated":248}},{"index":3,"name":null,"span":{"data":{"file_id":0,"beg":{"line":23,"col":14},"end":{"line":23,"col":15}},"generated_fro