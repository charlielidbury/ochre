ochr Hunt3 uses Nats {
  -- H: `matchInd` with fields and with a dependent field
  inductive Ch := L(u : Nat) | R(v : Nat)
  def Hg (c : Ch) (a : Nat) : Nat := match c { L(u) => u, R(v) => a }
  def HiL (a : Nat) : Nat := (let c = L(S(Z)); match c { L(u) => u, R(v) => a })
  def HiR (a : Nat) : Nat := (let c = R(S(Z)); match c { L(u) => u, R(v) => a })
  def HcL (u : Unit) : Nat := Hg(L(S(Z)), 5)
  def HcR (u : Unit) : Nat := Hg(R(S(Z)), 5)
  def HvR : Eq(Nat, Hg(R(S(Z)), 5), 5) := refl
  def H1g (c : &Ch) (a : Nat) : Nat := match *c { L(u) => clone(u), R(v) => a }
  def H1iL (a : Nat) : Nat := (let c0 = L(S(Z)); let c = &c0; match *c { L(u) => clone(u), R(v) => a })
  def H1uR (u : Unit) : Nat := (let c0 = R(S(Z)); H1g(&c0, 5))
  def H1uL (u : Unit) : Nat := (let c0 = L(S(Z)); H1g(&c0, 5))
  def H1vL : Eq(Nat, H1uL(()), 1) := refl
  def H2g (c : &Ch) (a : Nat) : Unit := match *c { L(u) => (u := a; ()), R(v) => () }
  def H2iR (a : Nat) : Unit := (let c0 = R(S(Z)); let c = &c0; match *c { L(u) => (u := a; ()), R(v) => () })
  def H2uL (u : Unit) : Ch := (let c0 = L(S(Z)); H2g(&c0, 5); c0)
  def H2vL : Eq(Ch, H2uL(()), L(5)) := refl
  inductive NBox (k : Nat) := MkNBox(v : Nat)
  inductive DV := DNil | DCons(k : Nat, b : NBox(k))
  def H3g (t : DV) (a : Nat) : Nat := match t { DNil => a, DCons(k, b) => k }
  def H3iC (a : Nat) : Nat := (let t = DCons(S(Z), MkNBox[S(Z)](Z)); match t { DNil => a, DCons(k, b) => k })
  def H3iN (a : Nat) : Nat := (let t = DNil; match t { DNil => a, DCons(k, b) => k })
  def H3cC (u : Unit) : Nat := H3g(DCons(S(Z), MkNBox[S(Z)](Z)), 4)
  def H3cN (u : Unit) : Nat := H3g(DNil, 4)
  def H3vC : Eq(Nat, H3g(DCons(S(Z), MkNBox[S(Z)](Z)), 4), 1) := refl
  def H4g (t : DV) (a : Nat) : Nat := match t { DNil => a, DCons(k, b) => match b { MkNBox(v) => v } }
  def H4iC (a : Nat) : Nat := (let t = DCons(S(Z), MkNBox[S(Z)](Z)); match t { DNil => a, DCons(k, b) => match b { MkNBox(v) => v } })
  def H4cC (u : Unit) : Nat := H4g(DCons(S(Z), MkNBox[S(Z)](3)), 4)
  def H4vC : Eq(Nat, H4g(DCons(S(Z), MkNBox[S(Z)](3)), 4), 3) := refl
  def H5g (t : &DV) (a : Nat) : Nat := match *t { DNil => a, DCons(k, b) => clone(k) }
  def H5iC (a : Nat) : Nat := (let t0 = DCons(S(Z), MkNBox[S(Z)](Z)); let t = &t0; match *t { DNil => a, DCons(k, b) => clone(k) })
  def H5uC (u : Unit) : Nat := (let t0 = DCons(S(Z), MkNBox[S(Z)](Z)); H5g(&t0, 4))
  def H6g (t : &DV) (a : Nat) : Unit := match *t { DNil => (), DCons(k, b) => (k := a; ()) }
  def H6iC (a : Nat) : Unit := (let t0 = DCons(S(Z), MkNBox[S(Z)](Z)); let t = &t0; match *t { DNil => (), DCons(k, b) => (k := a; ()) })
  def H6uC (u : Unit) : Unit := (let t0 = DCons(S(Z), MkNBox[S(Z)](Z)); H6g(&t0, 4))
  def H7g (t : &DV) (a : Nat) : Unit := match *t { DNil => (let q = a; ()), DCons(k, b) => (k := a; b := MkNBox[clone(k)](Z); ()) }
  def H7uC (u : Unit) : Unit := (let t0 = DCons(S(Z), MkNBox[S(Z)](Z)); H7g(&t0, 4))
  def H7uN (u : Unit) : Unit := (let t0 = DNil; H7g(&t0, 4))

  -- I: a match on a proof (by type)
  inductive Or2 (A : Prop) (B : Prop) : Prop := Inl(a : A) | Inr(b : B)
  def Ig (h : Or2(True, True)) (x : Nat) : True := match h { Inl(a) => a, Inr(b) => b }
  def IiL (x : Nat) : True := (let h = Inl[True, True](I); match h { Inl(a) => a, Inr(b) => b })
  def IcL (u : Unit) : True := Ig(Inl[True, True](I), 3)
  def I2g (h : Or2(True, True)) (x : Nat) : True := match h { Inl(a) => (let q = x; a), Inr(b) => b }
  def I2iR (x : Nat) : True := (let h = Inr[True, True](I); match h { Inl(a) => (let q = x; a), Inr(b) => b })
  def I2cR (u : Unit) : True := I2g(Inr[True, True](I), 3)
  def I3g (h : True ∧ True) (x : Nat) : Nat := match h { Intro(a, b) => x }
  def I3cR (u : Unit) : Nat := I3g(⟨I, I⟩, 3)

  -- K: a closure in an arm captures a variable
  def Kg (n : Nat) (a : Nat) : Nat → Nat := match n { Z => λ(k : Nat) : Nat => a, S _ => λ(k : Nat) : Nat => k }
  def KiS (a : Nat) : Nat → Nat := (let n = S(Z); match n { Z => λ(k : Nat) : Nat => a, S _ => λ(k : Nat) : Nat => k })
  def KiZ (a : Nat) : Nat → Nat := (let n = Z; match n { Z => λ(k : Nat) : Nat => a, S _ => λ(k : Nat) : Nat => k })
  def KuS (u : Unit) : Nat := (let f = Kg(S(Z), 4); f(2))
  def KvS : Eq(Nat, KuS(()), 2) := refl
  def K2g (n : Nat) (x : &Nat) : Unit → Unit := match n { Z => λ(k : Unit) : Unit => (*x := 3; ()), S _ => λ(k : Unit) : Unit => () }
  def K2iS (x : &Nat) : Unit → Unit := (let n = S(Z); match n { Z => λ(k : Unit) : Unit => (*x := 3; ()), S _ => λ(k : Unit) : Unit => () })

  -- J: a stuck program as the scrutinee (generalised, then split)
  def J1 (n : Nat) : Nat by n := match n { Z => Z, S m => S(J1(m)) }
  def Jg (n : Nat) (a : Nat) : Nat := (let k = J1(n); match k { Z => a, S _ => Z })
  def JiS (a : Nat) : Nat := (let k = J1(S(Z)); match k { Z => a, S _ => Z })
  def JcS (u : Unit) : Nat := Jg(S(Z), 5)
  def JcZ (u : Unit) : Nat := Jg(Z, 5)
  def JvZ : Eq(Nat, Jg(Z, 5), 5) := refl
}

