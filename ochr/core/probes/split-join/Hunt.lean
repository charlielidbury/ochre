import Ochr.Examples.Nat
open Ochr Ochr.Test

-- D119's hunt, run by hand before the fix (2026-11-21): differential twins of a tail match, one row
-- per body shape and path: `…g` the generic definition (path 3, the split), `…i<C>` the same body on a
-- let-bound known constructor (path 1), `…c<C>`/`…u<C>` a call with known arguments (path 2), `…v`/`…w`
-- a value by `refl`. Each row prints its verdict and the [Join] lines of its derivation, `depth:line`.
-- On main before D119 no accepted row was wrong, every value held, and a definition's paths had the
-- same verdict except where the arm that does not run is not checked (`Hunt3.KiS`, `K2iS`: a known
-- constructor's other arm is never checked, as at any instance); the generic rows dropped nothing at
-- the join. After D119 the verdicts are the same and the generic rows drop what their twins drop.
-- The asserted table is `ReturnedBorrows.SplitJoin` (generated by `gen.py` here).

def showJoins (r : Report) : String :=
  "\n".intercalate (r.rows.map fun row =>
    let v := match row.verdict with | .accepted => "ok" | .rejected m _ => "REJ " ++ m | .undecided m => "UND " ++ m
    let js := row.trace.toList.filterMap fun | .line s => if (s.splitOn "[Join]").length > 1 then some (toString ((s.length - (s.dropWhile (· == ' ')).length) / 2) ++ ":" ++ (s.dropWhile (· == ' ')).toString) else none | _ => none
    s!"{row.name}: {v}   joins={js}")

ochr Hunt1 uses Nats {
  -- A: the lead's example
  def Ag (n : Nat) : Nat := match n { Z => Z, S m => m }
  def AiZ (u : Unit) : Nat := (let n = Z; match n { Z => Z, S m => m })
  def AiS (u : Unit) : Nat := (let n = S(Z); match n { Z => Z, S m => m })
  def AcZ (u : Unit) : Nat := Ag(Z)
  def AcS (u : Unit) : Nat := Ag(S(Z))
  def AvZ : Eq(Nat, Ag(Z), Z) := refl
  def AvS : Eq(Nat, Ag(S(S(Z))), S(Z)) := refl
  def AwS : Eq(Nat, AiS(()), Z) := refl

  -- B: arms move different parts
  def Bg (n : Nat) (p : Nat × Nat) : Nat := match n { Z => p.0, S _ => p.1 }
  def BiZ (p : Nat × Nat) : Nat := (let n = Z; match n { Z => p.0, S _ => p.1 })
  def BiS (p : Nat × Nat) : Nat := (let n = S(Z); match n { Z => p.0, S _ => p.1 })
  def BcZ (u : Unit) : Nat := Bg(Z, (S(Z), Z))
  def BcS (u : Unit) : Nat := Bg(S(Z), (Z, S(Z)))
  def BvS : Eq(Nat, Bg(S(Z), (Z, S(Z))), S(Z)) := refl
  def B2g (n : Nat) (p : Nat × Nat) : Nat × Nat := match n { Z => (let a = p.0; (a, Z)), S _ => p }
  def B2iZ (p : Nat × Nat) : Nat × Nat := (let n = Z; match n { Z => (let a = p.0; (a, Z)), S _ => p })
  def B2iS (p : Nat × Nat) : Nat × Nat := (let n = S(Z); match n { Z => (let a = p.0; (a, Z)), S _ => p })
  def B2cZ (u : Unit) : Nat × Nat := B2g(Z, (S(Z), Z))
  def B2vZ : Eq(Nat × Nat, B2g(Z, (S(Z), S(Z))), (S(Z), Z)) := refl
  def B2cS (u : Unit) : Nat × Nat := B2g(S(Z), (S(Z), Z))
  def B3g (n : Nat) (p : Nat × Nat) : Nat × Nat := match n { Z => (let a = p.0; p.0 := S(a); p), S _ => (let b = p.1; (Z, b)) }
  def B3iZ (p : Nat × Nat) : Nat × Nat := (let n = Z; match n { Z => (let a = p.0; p.0 := S(a); p), S _ => (let b = p.1; (Z, b)) })
  def B3iS (p : Nat × Nat) : Nat × Nat := (let n = S(Z); match n { Z => (let a = p.0; p.0 := S(a); p), S _ => (let b = p.1; (Z, b)) })
  def B3cZ (u : Unit) : Nat × Nat := B3g(Z, (Z, Z))
  def B3vZ : Eq(Nat × Nat, B3g(Z, (Z, Z)), (S(Z), Z)) := refl
  def B3cS (u : Unit) : Nat × Nat := B3g(S(Z), (Z, S(Z)))
  def B3vS : Eq(Nat × Nat, B3g(S(Z), (Z, S(Z))), (Z, S(Z))) := refl

  -- C: a dependent return type that mentions the matched parameter
  def TF (n : Nat) : Type := match n { Z => Nat, S _ => Unit }
  def Cg (n : Nat) : TF(n) := match n { Z => Z, S m => () }
  def CiZ (u : Unit) : TF(Z) := (let n = Z; match n { Z => Z, S m => () })
  def CiS (u : Unit) : TF(S(Z)) := (let n = S(Z); match n { Z => Z, S m => () })
  def CcZ (u : Unit) : TF(Z) := Cg(Z)
  def CcS (u : Unit) : TF(S(Z)) := Cg(S(Z))
  def C2g (n : Nat) : Eq(Nat, n, n) := match n { Z => refl, S m => (let q = m; refl) }
  def C2iS (u : Unit) : Eq(Nat, S(Z), S(Z)) := (let n = S(Z); match n { Z => refl, S m => (let q = m; refl) })
  def C2cS (u : Unit) : Eq(Nat, S(Z), S(Z)) := C2g(S(Z))
  def C3g (n : Nat) (h : Eq(Nat, n, Z)) : Eq(Nat, Ag(n), Z) := match n { Z => refl, S m => match h {} }
  def C3cZ (u : Unit) : Eq(Nat, Ag(Z), Z) := C3g(Z, refl)
  def C4g (n : Nat) (x : Nat) : TF(n) := match n { Z => x, S m => () }
  def C4iZ (x : Nat) : TF(Z) := (let n = Z; match n { Z => x, S m => () })
  def C4iS (x : Nat) : TF(S(Z)) := (let n = S(Z); match n { Z => x, S m => () })
  def C4cZ (x : Nat) : TF(Z) := C4g(Z, x)
  def C4vZ : Eq(Nat, C4g(Z, S(Z)), S(Z)) := refl
  def C4cS (x : Nat) : TF(S(Z)) := C4g(S(Z), x)

  -- D: a result that is a borrow passed in by a parameter
  def Dg (n : Nat) (x : &Nat) (y : &Nat) : &Nat := match n { Z => x, S _ => y }
  def DiZ (x : &Nat) (y : &Nat) : &Nat := (let n = Z; match n { Z => x, S _ => y })
  def DiS (x : &Nat) (y : &Nat) : &Nat := (let n = S(Z); match n { Z => x, S _ => y })
  def DcZ (x : &Nat) (y : &Nat) : &Nat := Dg(Z, x, y)
  def DuZ (u : Unit) : Nat := (let a = 1; let b = 2; let r = Dg(Z, &a, &b); clone(*r))
  def DvZ : Eq(Nat, DuZ(()), 1) := refl
  def DcS (x : &Nat) (y : &Nat) : &Nat := Dg(S(Z), x, y)
  def DuS (u : Unit) : Nat := (let a = 1; let b = 2; let r = Dg(S(Z), &a, &b); clone(*r))
  def DvS : Eq(Nat, DuS(()), 2) := refl
  def D2g (n : Nat) (x : &Nat) (y : &Nat) : &Nat := match n { Z => &*x, S _ => (let q = x; y) }
  def D2iZ (x : &Nat) (y : &Nat) : &Nat := (let n = Z; match n { Z => &*x, S _ => (let q = x; y) })
  def D2iS (x : &Nat) (y : &Nat) : &Nat := (let n = S(Z); match n { Z => &*x, S _ => (let q = x; y) })
  def D2cZ (x : &Nat) (y : &Nat) : &Nat := D2g(Z, x, y)
  def D2cS (x : &Nat) (y : &Nat) : &Nat := D2g(S(Z), x, y)
  def D2uS (u : Unit) : Nat := (let a = 1; let b = 2; let r = D2g(S(Z), &a, &b); clone(*r))
  def D2vS : Eq(Nat, D2uS(()), 2) := refl
  def D2uZ (u : Unit) : Nat := (let a = 1; let b = 2; let r = D2g(Z, &a, &b); clone(*r))
  def D2vZ : Eq(Nat, D2uZ(()), 1) := refl
  def D3g (n : Nat) (x : &Nat) (y : &Nat) : &Nat := (let r = x; match n { Z => r, S _ => y })
  def D3iZ (x : &Nat) (y : &Nat) : &Nat := (let r = x; let n = Z; match n { Z => r, S _ => y })
  def D3iS (x : &Nat) (y : &Nat) : &Nat := (let r = x; let n = S(Z); match n { Z => r, S _ => y })
  def D3cZ (x : &Nat) (y : &Nat) : &Nat := D3g(Z, x, y)
  def D3cS (x : &Nat) (y : &Nat) : &Nat := D3g(S(Z), x, y)
  def D3uZ (u : Unit) : Nat := (let a = 1; let b = 2; let r = D3g(Z, &a, &b); clone(*r))
  def D3vZ : Eq(Nat, D3uZ(()), 1) := refl
  def D4g (n : Nat) (x : &(Nat × Nat)) (y : &Nat) : &Nat := match n { Z => &(*x).0, S _ => (let q = x; y) }
  def D4iZ (x : &(Nat × Nat)) (y : &Nat) : &Nat := (let n = Z; match n { Z => &(*x).0, S _ => (let q = x; y) })
  def D4cZ (x : &(Nat × Nat)) (y : &Nat) : &Nat := D4g(Z, x, y)
  def D4uZ (u : Unit) : Nat := (let a = (1, 3); let b = 2; let r = D4g(Z, &a, &b); clone(*r))
  def D4vZ : Eq(Nat, D4uZ(()), 1) := refl
  def D4uS (u : Unit) : Nat := (let a = (1, 3); let b = 2; let r = D4g(S(Z), &a, &b); clone(*r))
  def D4vS : Eq(Nat, D4uS(()), 2) := refl
  def D5g (n : Nat) (x : &(Nat × Nat)) (y : &Nat) : &Nat := (let r = &(*x).1; match n { Z => &(*x).0, S _ => (*r := Z; y) })
  def D5iZ (x : &(Nat × Nat)) (y : &Nat) : &Nat := (let r = &(*x).1; let n = Z; match n { Z => &(*x).0, S _ => (*r := Z; y) })
  def D5iS (x : &(Nat × Nat)) (y : &Nat) : &Nat := (let r = &(*x).1; let n = S(Z); match n { Z => &(*x).0, S _ => (*r := Z; y) })
  def D5cZ (x : &(Nat × Nat)) (y : &Nat) : &Nat := D5g(Z, x, y)
  def D5cS (x : &(Nat × Nat)) (y : &Nat) : &Nat := D5g(S(Z), x, y)
  def D5uZ (u : Unit) : Nat := (let a = (1, 3); let b = 2; let r = D5g(Z, &a, &b); clone(*r))
  def D5vZ : Eq(Nat, D5uZ(()), 1) := refl
  def D5uS (u : Unit) : Nat := (let a = (1, 3); let b = 2; let r = D5g(S(Z), &a, &b); let k = clone(*r); clone(a.1))
  def D5vS : Eq(Nat, D5uS(()), 0) := refl
  def D6g (n : Nat) (x : &Nat) (y : &Nat) : &Nat := (let r = &*x; match n { Z => r, S _ => (let q = x; y) })
  def D6iZ (x : &Nat) (y : &Nat) : &Nat := (let r = &*x; let n = Z; match n { Z => r, S _ => (let q = x; y) })
  def D6cZ (x : &Nat) (y : &Nat) : &Nat := D6g(Z, x, y)
  def D6uZ (u : Unit) : Nat := (let a = 1; let b = 2; let r = D6g(Z, &a, &b); clone(*r))
  def D6vZ : Eq(Nat, D6uZ(()), 1) := refl
}

