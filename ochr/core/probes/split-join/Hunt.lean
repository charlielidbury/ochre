ochr Hunt2 uses Nats {
  -- E: a result of an `Id` type
  def MovesAt (n : Nat) (x : Nat) : Prop := Id(Unit, (let r = &x; match n { Z => (let y = x; ()), S _ => () }), (let r = &x; let y = x; ()))
  def Eg (n : Nat) (x : Nat) : MovesAt(n, x) := match n { Z => refl, S _ => refl }
  def EiZ (x : Nat) : MovesAt(Z, x) := (let n = Z; match n { Z => refl, S _ => refl })
  def EiS (x : Nat) : MovesAt(S(Z), x) := (let n = S(Z); match n { Z => refl, S _ => refl })
  def EcZ (x : Nat) : MovesAt(Z, x) := Eg(Z, x)
  def EcS (u : Unit) : MovesAt(S(Z), 3) := Eg(S(Z), 3)
  def E2g (n : Nat) (x : Nat) : Id(Nat, clone(x), clone(x)) := match n { Z => refl, S m => (let q = x; refl) }
  def E2iS (x : Nat) : Id(Nat, clone(x), clone(x)) := (let n = S(Z); match n { Z => refl, S m => (let q = x; refl) })
  def E2iZ (x : Nat) : Id(Nat, clone(x), clone(x)) := (let n = Z; match n { Z => refl, S m => (let q = x; refl) })
  def E2cZ (u : Unit) : Id(Nat, 2, 2) := E2g(Z, 2)
  def E3g (n : Nat) (x : Nat) (h : Id(Unit, (let a = x; ()), (let b = x; ()))) : Id(Unit, (let a = x; ()), (let b = x; ())) := match n { Z => h, S _ => h }
  def E3iZ (x : Nat) (h : Id(Unit, (let a = x; ()), (let b = x; ()))) : Id(Unit, (let a = x; ()), (let b = x; ())) := (let n = Z; match n { Z => h, S _ => h })
  def E4g (n : Nat) (x : &Nat) : Id(Unit, (*x := 1; ()), (*x := 1; ())) := match n { Z => refl, S _ => (let q = x; refl) }
  def E4iZ (x : &Nat) : Id(Unit, (*x := 1; ()), (*x := 1; ())) := (let n = Z; match n { Z => refl, S _ => (let q = x; refl) })
  def E4iS (x : &Nat) : Id(Unit, (*x := 1; ()), (*x := 1; ())) := (let n = S(Z); match n { Z => refl, S _ => (let q = x; refl) })
  def E4cS (x : &Nat) : Id(Unit, (*x := 1; ()), (*x := 1; ())) := E4g(S(Z), x)
  def E5g (n : Nat) (x : Nat) (y : Nat) : Id(Unit, (let a = x; ()), (let b = x; ())) := match n { Z => (let q = y; refl), S _ => refl }
  def E5iS (x : Nat) (y : Nat) : Id(Unit, (let a = x; ()), (let b = x; ())) := (let n = S(Z); match n { Z => (let q = y; refl), S _ => refl })

  -- F: nested tail matches
  def Fg (n : Nat) (k : Nat) (a : Nat) (b : Nat) : Nat := match n { Z => match k { Z => a, S _ => b }, S _ => Z }
  def FiZu (k : Nat) (a : Nat) (b : Nat) : Nat := (let n = Z; match n { Z => match k { Z => a, S _ => b }, S _ => Z })
  def FiuZ (n : Nat) (a : Nat) (b : Nat) : Nat := match n { Z => (let k = Z; match k { Z => a, S _ => b }), S _ => Z }
  def FiZZ (a : Nat) (b : Nat) : Nat := (let n = Z; let k = Z; match n { Z => match k { Z => a, S _ => b }, S _ => Z })
  def FcZZ (u : Unit) : Nat := Fg(Z, Z, 1, 2)
  def FcZS (u : Unit) : Nat := Fg(Z, S(Z), 1, 2)
  def FcSZ (u : Unit) : Nat := Fg(S(Z), Z, 1, 2)
  def FvZS : Eq(Nat, Fg(Z, S(Z), 1, 2), 2) := refl
  def F2g (n : Nat) (k : Nat) (x : &Nat) (y : &Nat) : &Nat := match n { Z => match k { Z => x, S _ => &*y }, S _ => (let q = x; y) }
  def F2iZu (k : Nat) (x : &Nat) (y : &Nat) : &Nat := (let n = Z; match n { Z => match k { Z => x, S _ => &*y }, S _ => (let q = x; y) })
  def F2uZS (u : Unit) : Nat := (let a = 1; let b = 2; let r = F2g(Z, S(Z), &a, &b); clone(*r))
  def F2vZS : Eq(Nat, F2uZS(()), 2) := refl

  -- G: a tail match under `let` and under `;`
  def Gg (n : Nat) (a : Nat) : Nat := (let b = a; match n { Z => b, S _ => Z })
  def GiS (a : Nat) : Nat := (let b = a; let n = S(Z); match n { Z => b, S _ => Z })
  def GcS (u : Unit) : Nat := Gg(S(Z), 4)
  def G2g (n : Nat) (a : Nat) (x : &Nat) : Nat := (*x := Z; match n { Z => a, S _ => Z })
  def G2iS (a : Nat) (x : &Nat) : Nat := (*x := Z; let n = S(Z); match n { Z => a, S _ => Z })
  def G3g (n : Nat) (a : Nat) : Nat := (let r = &a; match n { Z => (*r := S(Z); Z), S _ => a })
  def G3iZ (a : Nat) : Nat := (let r = &a; let n = Z; match n { Z => (*r := S(Z); Z), S _ => a })
  def G3iS (a : Nat) : Nat := (let r = &a; let n = S(Z); match n { Z => (*r := S(Z); Z), S _ => a })
  def G3cZ (u : Unit) : Nat := G3g(Z, 4)
  def G3cS (u : Unit) : Nat := G3g(S(Z), 4)
  def G4g (n : Nat) (a : Nat) : Nat := (let r = &a; match n { Z => (let q = r; Z), S _ => a })
  def G4iZ (a : Nat) : Nat := (let r = &a; let n = Z; match n { Z => (let q = r; Z), S _ => a })
  def G4iS (a : Nat) : Nat := (let r = &a; let n = S(Z); match n { Z => (let q = r; Z), S _ => a })
  def G4cZ (u : Unit) : Nat := G4g(Z, 4)
  def G5g (n : Nat) (x : &Nat) (a : Nat) : Nat := (let r = &*x; match n { Z => (let q = x; a), S _ => (*r := a; Z) })
  def G5iZ (x : &Nat) (a : Nat) : Nat := (let r = &*x; let n = Z; match n { Z => (let q = x; a), S _ => (*r := a; Z) })
  def G5iS (x : &Nat) (a : Nat) : Nat := (let r = &*x; let n = S(Z); match n { Z => (let q = x; a), S _ => (*r := a; Z) })
  def G5uS (u : Unit) : Nat := (let c = 1; let k = G5g(S(Z), &c, 7); clone(c))
  def G5vS : Eq(Nat, G5uS(()), 7) := refl
  def G6g (n : Nat) (x : &Nat) (a : Nat) : Nat := (let r = x; match n { Z => (*r := a; Z), S _ => (let q = r; a) })
  def G6iZ (x : &Nat) (a : Nat) : Nat := (let r = x; let n = Z; match n { Z => (*r := a; Z), S _ => (let q = r; a) })
  def G6uZ (u : Unit) : Nat := (let c = 1; let k = G6g(Z, &c, 7); clone(c))
  def G6vZ : Eq(Nat, G6uZ(()), 7) := refl
  def G7g (n : Nat) (a : Nat) : Nat := (let r = &a; let s = &*r; match n { Z => (*s := 5; Z), S _ => (let q = r; Z) })
  def G7iZ (a : Nat) : Nat := (let r = &a; let s = &*r; let n = Z; match n { Z => (*s := 5; Z), S _ => (let q = r; Z) })
  def G7iS (a : Nat) : Nat := (let r = &a; let s = &*r; let n = S(Z); match n { Z => (*s := 5; Z), S _ => (let q = r; Z) })
  def G7cZ (u : Unit) : Nat := G7g(Z, 4)
}

