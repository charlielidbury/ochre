ochr Hunt4 uses Nats {
  -- K: a closure in an arm captures a variable
  def Kg (n : Nat) (a : Nat) : Nat → Nat := match n { Z => λ(k : Nat) : Nat => clone(a), S _ => λ(k : Nat) : Nat => k }
  def KiS (a : Nat) : Nat → Nat := (let n = S(Z); match n { Z => λ(k : Nat) : Nat => clone(a), S _ => λ(k : Nat) : Nat => k })
  def KiZ (a : Nat) : Nat → Nat := (let n = Z; match n { Z => λ(k : Nat) : Nat => clone(a), S _ => λ(k : Nat) : Nat => k })
  def KuS (u : Unit) : Nat := (let f = Kg(S(Z), 4); f(2))
  def KvS : Eq(Nat, KuS(()), 2) := refl
  def KuZ (u : Unit) : Nat := (let f = Kg(Z, 4); f(2))
  def KvZ : Eq(Nat, KuZ(()), 4) := refl
  def K3g (n : Nat) (a : Nat) (b : Nat) : Nat × (Nat → Nat) := match n { Z => (b, λ(k : Nat) : Nat => clone(a)), S _ => (a, λ(k : Nat) : Nat => k) }
  def K3iS (a : Nat) (b : Nat) : Nat × (Nat → Nat) := (let n = S(Z); match n { Z => (b, λ(k : Nat) : Nat => clone(a)), S _ => (a, λ(k : Nat) : Nat => k) })
  def K3iZ (a : Nat) (b : Nat) : Nat × (Nat → Nat) := (let n = Z; match n { Z => (b, λ(k : Nat) : Nat => clone(a)), S _ => (a, λ(k : Nat) : Nat => k) })
  def K3uS (u : Unit) : Nat := (let p = K3g(S(Z), 4, 5); clone(p.0))

  -- I: a match on a proof (by type), with effects in the arms
  inductive Or2 (A : Prop) (B : Prop) : Prop := Inl(a : A) | Inr(b : B)
  def I4g (h : Or2(True, True)) (y : &Nat) : True := match h { Inl(a) => (*y := 5; a), Inr(b) => b }
  def I4uL (u : Unit) : Nat := (let c = 1; let p = I4g(Inl[True, True](I), &c); clone(c))
  def I4vL1 : Eq(Nat, I4uL(()), 1) := refl
  def I4vL5 : Eq(Nat, I4uL(()), 5) := refl
  def I5g (h : Or2(True, True)) (x : Nat) (y : Nat) : True := match h { Inl(a) => (let q = x; a), Inr(b) => (let q = y; b) }
  def I5uL (u : Unit) : True := I5g(Inl[True, True](I), 1, 2)
  def I6g (h : Or2(True, True)) (x : Nat) : Nat := (let p : True = match h { Inl(a) => (let q = x; a), Inr(b) => b }; Z)

  -- the braces form `split f(ā) { … }` (D61, D126): the arms are a match on the call
  def SF (n : Nat) : Nat by n := match n { Z => Z, S m => S(SF(m)) }
  def SPg (n : Nat) (a : Nat) : Eq(Nat, SF(n), SF(n)) := split SF(n) { Z => (let q = a; refl), S k => refl }
}

