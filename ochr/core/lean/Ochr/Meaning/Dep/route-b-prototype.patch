+/-- PROTOTYPE (dep lane, not for landing): a type term whose values are constructor values of a
+data inductive at every instance, read through type-function bodies (their match arms and lets). -/
+def treeTerm (fuel : Nat) (vis : List String) (T : Term) : M Bool := do
+  match fuel with
+  | 0 => pure false
+  | fuel' + 1 =>
+  match T with
+  | .tind m _ => pure ((← lookupInd m).sort != 0)
+  | .call (.const f) _ _ =>
+    if vis.contains f then return true
+    let some g := (← get).globals.find? (·.name == f) | return false
+    let some (.fix _ _ _ c _ body) := g.fn? | return false
+    unless c matches .sort _ do return false
+    treeTerm fuel' (f :: vis) body
+  | .matchInd _ _ arms =>
+    let mut ok := true
+    for (_, a) in arms do
+      if !(← treeTerm fuel' vis a) then ok := false
+    pure ok
+  | .matchNat _ z s => pure ((← treeTerm fuel' vis z) && (← treeTerm fuel' vis s))
+  | .letIn _ _ w | .seq _ w | .ascribe w _ => treeTerm fuel' vis w
+  | _ => pure false
+
+/-- PROTOTYPE (dep lane): a dependent field that is neither a proof nor tree-valued (a leaf:
+a number, the unit, a function, a type parameter's value). -/
+def fieldIsLeafDep (d : IndDecl) (c i : Nat) (FT : Term) : M Bool := do
+  if !d.fieldDependent c i then return false
+  if ← fieldTermIsProp d FT then return false
+  pure !(← treeTerm 64 [] FT)
+
 /-- A field place is a proof iff its declared type is a proposition (syntactic, D42). -/
